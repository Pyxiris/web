<templates>
    <t t-name="web_responsive.AppsMenu">
        <div
            class="o_apps_menu"
            tabindex="-1"
            t-ref="appsMenuRoot"
            t-on-keydown="onAppsMenuKeydown"
        >
            <button
                type="button"
                class="search-icon-button o-app-menu-item fa fa-search fs-5"
                title="Search menus..."
                t-on-click="onAppsMenuSearchClick"
            />
            <div class="o-app-menu-list">
                <a
                    t-foreach="apps"
                    t-as="app"
                    t-key="app.id"
                    class="o-app-menu-item o_app"
                    t-att-class="{active: currentApp === app}"
                    t-att-data-menu-xmlid="app.xmlid"
                    t-att-href="getMenuItemHref(app)"
                    t-on-click.prevent="() => this.onAppClick(app)"
                    draggable="false"
                >
                    <div class="position-relative">
                        <img
                            t-if="app.webIconData"
                            class="o-app-menu-item__icon rounded-3"
                            draggable="false"
                            t-attf-src="{{app.webIconData}}"
                        />
                        <i
                            t-if="currentApp === app"
                            class="fa fa-check-circle o-app-menu-item__active"
                        />
                    </div>
                    <span class="o-app-menu-item__name" t-att-title="app.name">
                        <t t-esc="app.name" />
                    </span>
                </a>
            </div>
        </div>
    </t>

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='this.ui.isSmall']" position="before">
            <div t-if="!isScopedApp and showAppsMenuButton" class="o_navbar_apps_menu">
                <div class="o_grid_apps_menu">
                    <button
                        class="o_grid_apps_menu__button"
                        t-att-class="{ active: isAppsMenuOpen }"
                        title="Apps Menu"
                        data-hotkey="h"
                        t-on-click.stop="openAppsMenu"
                    >
                        <i class="oi oi-apps fs-4" />
                    </button>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-else='']" position="replace">
            <t t-else="">
                <div t-if="isScopedApp" class="mx-2" />
            </t>
        </xpath>
    </t>
</templates>
