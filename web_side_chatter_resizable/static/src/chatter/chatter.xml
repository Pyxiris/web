<templates xml:space="preserve">
    <t t-name="web_side_chatter_resizable.Chatter">
        <t t-if="props.isChatterAside">
            <ResizablePanel
                handleSide="'start'"
                class="'h-100 flex-shrink-0'"
                minWidth="chatterMinWidth"
                initialWidth="chatterWidth"
                onResize.bind="onChatterResize"
            >
                <t t-call="mail.Chatter" />
            </ResizablePanel>
        </t>
        <t t-else="">
            <t t-call="mail.Chatter" />
        </t>
    </t>
</templates>
